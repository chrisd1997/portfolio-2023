# Serves the static export (out/, copied to /srv by the Dockerfile). TLS and
# the public hostnames are handled by the proxy in front of it.
{
	admin off
	auto_https off
	persist_config off
}

:3000 {
	root * /srv
	encode zstd gzip
	# Clean URLs: /about -> about.html
	try_files {path} {path}.html {path}/index.html
	file_server
	# Next's build assets have content hashes in their names
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
